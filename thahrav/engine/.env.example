# Copy this file to engine/.env and fill in what you have.
# engine/.env is git-ignored. Never commit real keys.

# --- Script writer (at least one is required) ---------------------------------
# Claude is used when this is set (decision D11).
ANTHROPIC_API_KEY=
# Used when ANTHROPIC_API_KEY is empty, or with --provider groq.
GROQ_API_KEY=

# Optional overrides
# THAHRAV_PROVIDER=auto            # auto | claude | groq
# THAHRAV_CLAUDE_MODEL=claude-opus-5-5
# THAHRAV_CLAUDE_EFFORT=high       # low | medium | high | xhigh | max
# THAHRAV_GROQ_MODEL=llama-3.3-70b-versatile

# First-person Hindi verb forms in scripts: masculine ("main karta tha")
# or feminine ("main karti thi").
THAHRAV_HINDI_VERB_FORM=masculine

# --- Notion (optional; scripts are always saved as local files too) -----------
NOTION_API_KEY=
# Filled in after running: thahrav notion-setup --parent-page <page id>
NOTION_CONTENT_DB_ID=
