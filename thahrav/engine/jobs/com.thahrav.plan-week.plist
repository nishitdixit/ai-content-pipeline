<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Writes next week's scripts every Saturday at 21:00, ready for the Sunday review.
  Install:   cp engine/jobs/com.thahrav.plan-week.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.thahrav.plan-week.plist
  Run now:   launchctl start com.thahrav.plan-week
  Remove:    launchctl unload ~/Library/LaunchAgents/com.thahrav.plan-week.plist
  If the Mac is asleep at 21:00, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thahrav.plan-week</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/nishitdixit/project/ai_project/thahrav/engine/.venv/bin/thahrav</string>
        <string>plan-week</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nishitdixit/project/ai_project/thahrav/engine</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/nishitdixit/project/ai_project/thahrav/engine/logs/plan-week.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nishitdixit/project/ai_project/thahrav/engine/logs/plan-week.log</string>
</dict>
</plist>
