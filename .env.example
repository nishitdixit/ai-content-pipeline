# Copy to .env and fill in what you have. .env is git-ignored; never commit real keys.
# Nothing here is required: `acp demo` runs fully offline.

# --- Script writer (at least one for real scripts; otherwise use --provider mock) ---
# Claude is used when this is set.
ANTHROPIC_API_KEY=
# Used when ANTHROPIC_API_KEY is empty, or with --provider groq.
GROQ_API_KEY=

# Optional overrides
# ACP_PROVIDER=auto              # auto | claude | groq | mock
# ACP_CLAUDE_MODEL=claude-opus-5-5
# ACP_CLAUDE_EFFORT=high         # low | medium | high | xhigh | max
# ACP_GROQ_MODEL=llama-3.3-70b-versatile
# ACP_PROFILE=thahrav            # channel profile under profiles/
# ACP_VERB_FORM=masculine        # overrides the profile's first-person verb form

# --- Notion mirror (optional; scripts are always saved as local files too) ---
NOTION_API_KEY=
# Filled in after running: acp notion-setup --parent-page <page id>
NOTION_CONTENT_DB_ID=

# --- Studio: any capability whose key is set switches from mock to the live service ---
# Transcription with word timestamps (Deepgram)
DEEPGRAM_API_KEY=
